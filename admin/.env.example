# ==============================================================================
# Portfolio Admin API - Environment Configuration
# ==============================================================================

# Server Port (default 3000 for standalone, Vercel manages automatically in serverless)
PORT=3000

# MongoDB Connection String (Atlas URI or local mongodb)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio_admin?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>/portfolio_admin?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_secure_jwt_secret_token

# Default Admin Login Credentials (used if not already seeded)
ADMIN_EMAIL=shubh-tech96@gmail.com
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_NAME=Shubham Prajapati

# Allowed CORS Origins (* for any, or comma-separated list of origins)
CORS_ORIGIN=*

# Production Hosted Site URL (for direct APK download redirection)
SITE_URL=https://shubhamprajapati.dev
